#!/bin/sh
# Runs the checks CI runs, inside the trixie build container: formatting,
# a build with warnings as errors, the unit tests, and clang-tidy. Covers
# tracked files and untracked files that are not ignored. Runs without
# network access, as Debian package builds do, so the archives from
# scripts/fetch-deps are fetched on the host first.
set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
"$root/scripts/fetch-deps" >/dev/null

CONTAINER_NETWORK=none "$root/scripts/container" sh -euc '
    build=build/container
    git config --global --add safe.directory /src
    sources() { git ls-files -z --cached --others --exclude-standard -- "$@"; }

    echo "== clang-format"
    sources "*.cpp" "*.h" | xargs -0 clang-format --dry-run -Werror

    echo "== build"
    cmake --preset linux-debug -B "$build" -DLEGILO_WARNINGS_AS_ERRORS=ON >/dev/null
    cmake --build "$build"

    echo "== tests"
    ctest --test-dir "$build" --output-on-failure --no-tests=error

    echo "== clang-tidy"
    sources "*.cpp" | xargs -0 -P "$(nproc)" -n 1 \
        clang-tidy -p "$build" --quiet --warnings-as-errors="*"
'
